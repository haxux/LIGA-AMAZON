<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the test suite against the real managed MySQL (TiDB Cloud) instead of
  the in-memory SQLite that phpunit.xml forces.

  WHY THIS FILE EXISTS
  phpunit.xml pins DB_CONNECTION=sqlite, so `php artisan test` can never tell
  you whether the deployment target honours this schema. That matters here:
  the ten foreign keys in database/migrations carry business rules — a game
  restricts deletion of a team that played it, news null out their team, a
  season cascades to everything beneath it — and a MySQL-*compatible* engine
  is precisely where those semantics may diverge from MySQL 8.
  DeleteStrategyTest is the check that decides whether TiDB is usable.

  USAGE
  Do not invoke this file by hand: run ./scripts/test-tidb.sh, which sources
  the credentials from .env.tidb (gitignored, never echoed) and prints the
  target host first. Without that guard a missing DB_HOST would silently fall
  back to the local `db` container, and the run would look like a pass while
  proving nothing about TiDB.

  DANGER
  RefreshDatabase drops and recreates every table on the target database on
  each run. Point DB_DATABASE at a throwaway database (liga_amazon_test),
  never at the one that holds real league data.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
          Everything unrelated to the database is pinned exactly as in
          phpunit.xml, so the only variable between the two runs is the engine.
          The DB_* values are deliberately absent: they come from .env.tidb via
          the process environment, which Laravel's immutable dotenv will not
          override.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="UPLOADS_DISK" value="public" force="true"/>
        <!--
          Releases the SQLite pin in tests/TestCase.php. Without it the suite
          runs on SQLite no matter what the DB_* variables say, and reports a
          pass that proves nothing about the deployment target.
        -->
        <env name="TEST_AGAINST_REAL_DB" value="1" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
