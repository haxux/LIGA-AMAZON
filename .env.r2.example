# Credenciales de Cloudflare R2 para las imagenes que sube el panel.
#
# Copiar a .env.r2 (ignorado por git) y rellenar desde el panel de Cloudflare.
# Donde encontrar cada valor esta indicado debajo.

# R2 -> Overview -> "Account ID" en la barra lateral derecha.
# El endpoint se forma con el: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ENDPOINT=

# Nombre del bucket que creaste (sugerencia: liga-amazon).
AWS_BUCKET=

# R2 -> API -> Manage API tokens -> Create User API token
# Permisos: "Object Read & Write", limitado al bucket de arriba.
# El secreto se muestra UNA sola vez; si se pierde, se regenera.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URL publica de lectura: la del bucket -> Settings -> Public Development URL
# (termina en .r2.dev), o tu dominio propio si lo configuras.
# Es la que acaba en el <img> del navegador. Si se deja vacia, las imagenes se
# enlazan contra el endpoint privado y no cargan para los visitantes.
AWS_URL=

# Fijos para R2, no tocar.
AWS_DEFAULT_REGION=auto
AWS_USE_PATH_STYLE_ENDPOINT=true
UPLOADS_DISK=s3
