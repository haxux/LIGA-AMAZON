# Liga Amazon — plantilla de entorno para PRODUCCIÓN.
#
# NO es una copia de .env.example, que es un archivo de desarrollo y activa el
# modo debug. Con debug activo, cualquier excepción no capturada muestra la
# traza completa y TODAS las variables de entorno — credenciales de base de
# datos incluidas — a quien visite la página.
#
# Este archivo no contiene ni una sola credencial real. Todos los valores
# secretos se dejan vacíos a propósito y se rellenan en el servidor.
#
# Pasos de despliegue: ver DESPLIEGUE.md

APP_NAME="Liga Amazon"
APP_ENV=production
# Generar EN EL SERVIDOR con `php artisan key:generate`.
# Nunca reutilizar la clave de desarrollo: cifra sesiones y cookies.
APP_KEY=
APP_DEBUG=false
APP_URL=https://CAMBIAR-POR-TU-DOMINIO
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Fuerza el esquema https en las URLs generadas. Interruptor propio, no
# deducido de APP_ENV, para poder desactivarlo sin tocar código si el proxy
# provoca un bucle de redirección. Requiere ->trustProxies() configurado en
# bootstrap/app.php — ver DESPLIEGUE.md, están emparejados.
APP_FORCE_HTTPS=true

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr, no stack/daily: en un contenedor efímero (Vercel) los archivos de
# storage/logs se pierden al terminar la invocación, y el filesystem puede ser
# de sólo lectura. A stderr los recoge el panel de logs del host.
# En un servidor con disco propio, volver a LOG_CHANNEL=stack + LOG_STACK=daily.
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
# Nunca debug en producción: los logs de debug filtran datos de las peticiones.
LOG_LEVEL=error

# MySQL gestionado (TiDB Cloud Starter). Ya no hay contenedor `db`: el host
# es serverless y no aloja base de datos. No existe usuario root que
# configurar — el proveedor sólo entrega un usuario de aplicación.
DB_CONNECTION=mysql
DB_HOST=
# 4000 es el puerto de TiDB, no el 3306 de MySQL. Confirmar en su panel.
DB_PORT=4000
DB_DATABASE=liga_amazon
DB_USERNAME=
DB_PASSWORD=
# TLS obligatorio: el proveedor rechaza conexiones en claro. Ruta al almacén de
# CA del sistema dentro del contenedor (imagen Debian). Sin esto la conexión
# falla con un error de SSL que no menciona el certificado.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cifra el contenido de la sesión en almacenamiento.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# La cookie de sesión sólo viaja por HTTPS. Sin esto, la sesión del admin
# circula en claro. Requiere que el certificado ya funcione.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Disco de las imágenes subidas desde el panel (escudos y portadas).
# En un filesystem efímero TIENE que ser 's3': con 'public' cada escudo que
# suba el administrador desaparece en cuanto el contenedor se recicla.
UPLOADS_DISK=s3

# Credenciales del bucket (Cloudflare R2, compatible con S3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 no tiene regiones al estilo AWS: el valor literal es 'auto'.
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Endpoint privado de la API, donde la aplicación escribe.
AWS_ENDPOINT=
# URL pública de lectura del bucket, la que acaba en el <img> del navegador.
# Si se deja vacía, las imágenes se enlazan contra el endpoint privado y no
# cargan para los visitantes.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# sync, no database: en serverless no hay ningún worker ejecutando
# `queue:work`, así que un job encolado no se procesaría jamás. Hoy la
# aplicación no despacha ninguno, de modo que sync no ejecuta nada de más.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# MAIL_MAILER=log escribe el correo en el archivo de log en lugar de enviarlo.
# Sirve mientras no haya ningún flujo de correo. Si algún día se activa el
# restablecimiento de contraseña, hay que configurar SMTP real ANTES: si no,
# el enlace de reseteo queda escrito en texto plano en el log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

UID=1000
GID=1000
