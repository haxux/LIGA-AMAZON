# Liga Amazon — plantilla de entorno para PRODUCCIÓN.
#
# NO es una copia de .env.example, que es un archivo de desarrollo y activa el
# modo debug. Con debug activo, cualquier excepción no capturada muestra la
# traza completa y TODAS las variables de entorno — credenciales de base de
# datos incluidas — a quien visite la página.
#
# Este archivo no contiene ni una sola credencial real. Todos los valores
# secretos se dejan vacíos a propósito y se rellenan en el servidor.
#
# Pasos de despliegue: ver DESPLIEGUE.md

APP_NAME="Liga Amazon"
APP_ENV=production
# Generar EN EL SERVIDOR con `php artisan key:generate`.
# Nunca reutilizar la clave de desarrollo: cifra sesiones y cookies.
APP_KEY=
APP_DEBUG=false
APP_URL=https://CAMBIAR-POR-TU-DOMINIO
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Fuerza el esquema https en las URLs generadas. Interruptor propio, no
# deducido de APP_ENV, para poder desactivarlo sin tocar código si el proxy
# provoca un bucle de redirección. Requiere ->trustProxies() configurado en
# bootstrap/app.php — ver DESPLIEGUE.md, están emparejados.
APP_FORCE_HTTPS=true

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily, no single: un único archivo crece sin límite hasta llenar el disco.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Nunca debug en producción: los logs de debug filtran datos de las peticiones.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=liga_amazon
DB_USERNAME=
# Rellenar en el servidor. Larga y aleatoria; no reutilizar la de desarrollo.
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cifra el contenido de la sesión en almacenamiento.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# La cookie de sesión sólo viaja por HTTPS. Sin esto, la sesión del admin
# circula en claro. Requiere que el certificado ya funcione.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# MAIL_MAILER=log escribe el correo en el archivo de log en lugar de enviarlo.
# Sirve mientras no haya ningún flujo de correo. Si algún día se activa el
# restablecimiento de contraseña, hay que configurar SMTP real ANTES: si no,
# el enlace de reseteo queda escrito en texto plano en el log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

UID=1000
GID=1000
