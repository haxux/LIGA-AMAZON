# Plantilla del .env de PRODUCCIÓN (Hostinger). Se copia al servidor como
# `.env` y se rellena allí; nunca se sube el .env de desarrollo, y este fichero
# no lleva ningún valor secreto dentro: los huecos vacíos se rellenan en el
# servidor y punto.
#
# Ver DESPLIEGUE.md para el procedimiento completo.

APP_NAME="Liga Amazon"
APP_ENV=production
# Se genera EN EL SERVIDOR con `php artisan key:generate`. Jamás la de
# desarrollo: quien tenga la clave puede descifrar cookies y sesiones.
APP_KEY=
APP_DEBUG=false
APP_URL=https://ligaamazon.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
# Fuerza el esquema https al generar URLs. Encendido en cuanto el dominio tiene
# certificado; sin él, las URLs salen en http y el navegador bloquea recursos.
APP_FORCE_HTTPS=true
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# A fichero, no a stderr: aquí hay disco propio y los logs se leen por SSH o por
# el administrador de archivos. En Vercel iban a stderr porque no había disco.
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB en la misma máquina. `mariadb` y no `mysql`: Laravel trae un driver
# propio desde la 11 que conoce sus diferencias. Sin SSL ni CA que configurar,
# porque la conexión no sale del servidor.
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# En base de datos y no en fichero: así el panel y el sitio comparten sesión
# aunque algún día haya más de un proceso.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# Las subidas van al disco del servidor. Hostinger tiene disco persistente, así
# que una imagen subida desde el panel se queda donde se escribe. Requiere que
# `php artisan storage:link` esté hecho.
FILESYSTEM_DISK=local
UPLOADS_DISK=public

# Sin worker: lo que se encola se ejecuta en la misma petición. Son pocos envíos
# y ninguno tarda.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# El par VAPID de las notificaciones push se genera UNA VEZ y no vuelve a
# cambiar: cambiarlo invalida todas las suscripciones ya guardadas.
# `php artisan tinker` -> Minishlink\WebPush\VAPID::createVapidKeys().
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Cadena aleatoria larga (`openssl rand -hex 32`). El trabajo cron del servidor
# la manda como `Authorization: Bearer <valor>` al pedir /cron/tick. Sin ella
# configurada, esa ruta se niega siempre.
CRON_SECRET=
