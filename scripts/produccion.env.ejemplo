# Coordenadas del servidor de producción. Copiar a `produccion.env` —que está
# en .gitignore— y rellenar.
#
# No se versiona a propósito: el repositorio es público. La clave privada nunca
# ha estado en git y no debe estarlo; aquí va sólo su RUTA.
CLAVE=~/.ssh/nombre_de_tu_clave
PUERTO=22
REMOTO=usuario@servidor
RUTA='~/domains/tudominio.com/app'   # entre comillas: la tilde la expande el servidor, no tu shell
PHP=/opt/alt/php84/usr/bin/php
SITIO=https://tudominio.com
