# El contexto de build no debe llevar secretos ni artefactos locales.
.git
.github

# Todo fichero de entorno: pueden llevar credenciales reales, y una imagen no
# debe llevarlas dentro nunca.
.env
.env.*

# Se reinstalan dentro del build, y copiarlos rompería la imagen si el host es
# de otra arquitectura.
node_modules
vendor
public/build

# No hacen falta en producción.
tests
phpunit.xml
phpunit.tidb.xml
scripts
storage/logs
storage/backups
.phpunit.result.cache
public/hot
