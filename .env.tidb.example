# Credenciales de TiDB Cloud para ejecutar la suite contra el motor real.
#
# Copiar a .env.tidb (ignorado por git) y rellenar desde el panel de TiDB:
# en el cluster, botón "Connect" → los datos de host, puerto y usuario salen
# ahí. La contraseña sólo se muestra al generarla; si se perdió, se regenera.
#
# Se ejecuta con ./scripts/test-tidb.sh
#
# PELIGRO: RefreshDatabase borra y recrea TODAS las tablas de DB_DATABASE en
# cada ejecución. Apuntar a una base desechable, nunca a la de la liga real.

DB_CONNECTION=mysql
DB_HOST=
# 4000 es el puerto de TiDB, no el 3306 de MySQL.
DB_PORT=4000
# Base desechable, distinta de la de producción. Crearla antes en el panel.
DB_DATABASE=liga_amazon_test
DB_USERNAME=
DB_PASSWORD=
# Vacío a propósito: si quedara una DB_URL heredada, ganaría sobre todo lo de
# arriba y la suite se ejecutaría contra otro sitio sin avisar.
DB_URL=

# TLS obligatorio en TiDB Cloud. Ruta del almacén de CA dentro del contenedor.
# Sin esto la conexión falla con un error de SSL que no menciona el
# certificado.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
