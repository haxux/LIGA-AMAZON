# Imagen de despliegue para Vercel: FrankenPHP (PHP + servidor Caddy) en un
# contenedor. No sustituye a docker/php/Dockerfile, que sigue siendo el entorno
# de desarrollo con PHP-FPM y nginx.
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

# php.ini-production, no el de desarrollo: display_errors=Off y
# opcache.validate_timestamps=0. Resuelve el §3.4 de DESPLIEGUE.md.
#
# Extensiones: las mismas que docker/php/Dockerfile salvo pcntl, que sólo hace
# falta para workers de cola y aquí no hay ninguno. pdo_mysql para TiDB, gd y
# exif para las imágenes que sube el panel, intl y bcmath para Filament, y
# opcache porque en serverless cada arranque en frío recompila la aplicación
# entera.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_mysql bcmath gd exif opcache

WORKDIR /app

# ---------------------------------------------------------------------------
# Assets del frontend. public/build está en .gitignore, así que si Vite no se
# ejecuta aquí el sitio se despliega literalmente sin hojas de estilo.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS assets

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.js ./
COPY resources ./resources
RUN npm run build

# ---------------------------------------------------------------------------
# Dependencias de PHP.
# ---------------------------------------------------------------------------
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./

# --no-scripts es seguro aquí: los assets de Filament están commiteados en
# public/, así que no hace falta que el post-install los vuelva a publicar.
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .
COPY --from=assets /app/public/build ./public/build

RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative

# ---------------------------------------------------------------------------
# Imagen final.
# ---------------------------------------------------------------------------
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile
COPY --chown=www-data:www-data docker/vercel/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Aquí NO se fijan SESSION_DRIVER, CACHE_STORE ni QUEUE_CONNECTION, a
# diferencia del ejemplo oficial de Vercel, que los pone en 'array'. Con
# sesiones en array el login del panel se rompe en silencio: cada petición
# empieza sin sesión y el administrador nunca llega a entrar. Sin valor aquí
# mandan los de Laravel (database), que son los correctos, y las variables de
# Vercel los fijan explícitamente.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

USER www-data

CMD ["/usr/local/bin/entrypoint.sh"]
