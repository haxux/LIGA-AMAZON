# Imagen de despliegue para Vercel: FrankenPHP (PHP + servidor Caddy) en un
# contenedor. No sustituye a docker/php/Dockerfile, que sigue siendo el entorno
# de desarrollo con PHP-FPM y nginx.
FROM dunglas/frankenphp:1-php8.4-alpine AS base

# Alpine, no bookworm: 265 MB de base frente a 837 MB. La diferencia se paga
# en cada arranque en frío, porque el host escala a cero tras 5 minutos sin
# tráfico y vuelve a traerse la imagen. El almacén de CA está en la misma ruta
# que en Debian, así que MYSQL_ATTR_SSL_CA no cambia.
#
# php.ini-production, no el de desarrollo: display_errors=Off y
# opcache.validate_timestamps=0. Resuelve el §3.4 de DESPLIEGUE.md.
#
# Extensiones: las mismas que docker/php/Dockerfile salvo pcntl, que sólo hace
# falta para workers de cola y aquí no hay ninguno. pdo_mysql para TiDB, gd y
# exif para las imágenes que sube el panel, intl y bcmath para Filament, y
# opcache porque en serverless cada arranque en frío recompila la aplicación
# entera.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_mysql bcmath gd exif opcache

WORKDIR /app

# ---------------------------------------------------------------------------
# Assets del frontend. public/build está en .gitignore, así que si Vite no se
# ejecuta aquí el sitio se despliega literalmente sin hojas de estilo.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS assets

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.js ./
COPY resources ./resources
RUN npm run build

# ---------------------------------------------------------------------------
# Dependencias de PHP.
# ---------------------------------------------------------------------------
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./

# --no-scripts es seguro aquí: los assets de Filament están commiteados en
# public/, así que no hace falta que el post-install los vuelva a publicar.
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .
COPY --from=assets /app/public/build ./public/build

RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative

# Solo se hornea el cacheo de VISTAS. Blade no lee entorno en absoluto, asi que
# compilar las plantillas aqui ahorra ese trabajo en cada arranque en frio.
#
# route:cache NO se hornea, y esto no es una omision: Livewire deriva el prefijo
# de sus endpoints de APP_KEY
# (EndpointResolver::prefix() -> sha256(config('app.key').'livewire-endpoint')),
# que durante el build no existe. Cachear las rutas aqui las congela con un hash
# calculado sobre una clave vacia, mientras que las paginas servidas usan la
# real: el JavaScript de Livewire y su endpoint /update devuelven 404 y el panel
# entero se queda sin interactividad, en silencio, porque el sitio publico —que
# no usa Livewire— sigue funcionando. Ocurrio el 2026-09-20. Ver §5.2 de
# DESPLIEGUE.md.
RUN php artisan view:cache

# Cuantas migraciones trae esta imagen. El entrypoint compara este numero con
# las filas de la tabla `migrations` para saber, por 0,6 s en vez de 4,2 s, si
# hay algo que migrar en este arranque. Aqui es donde la lista de ficheros es
# definitiva; en tiempo de arranque contarlos tambien valdria, pero el fichero
# deja el numero dicho y el arranque no tiene que recorrer el directorio.
RUN ls database/migrations/*.php | wc -l > /app/.migraciones-esperadas

# ---------------------------------------------------------------------------
# Imagen final.
# ---------------------------------------------------------------------------
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile
# --chmod en el COPY, no un chmod posterior: cada RUN que toca un fichero
# escribe una capa nueva con el fichero entero dentro.
COPY --chown=www-data:www-data --chmod=755 docker/vercel/entrypoint.sh /usr/local/bin/entrypoint.sh

# Aquí NO se hace setcap sobre frankenphp. La imagen base ya le da
# cap_net_bind_service=ep, y repetirlo modificaba el binario, lo que copiaba sus
# 57,5 MB a una capa nueva para no cambiar nada.
RUN chown -R www-data:www-data /config/caddy /data/caddy

# Aquí NO se fijan SESSION_DRIVER, CACHE_STORE ni QUEUE_CONNECTION, a
# diferencia del ejemplo oficial de Vercel, que los pone en 'array'. Con
# sesiones en array el login del panel se rompe en silencio: cada petición
# empieza sin sesión y el administrador nunca llega a entrar. Sin valor aquí
# mandan los de Laravel (database), que son los correctos, y las variables de
# Vercel los fijan explícitamente.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

USER www-data

CMD ["/usr/local/bin/entrypoint.sh"]
